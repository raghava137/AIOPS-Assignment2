# Naive, single-stage build.
# Everything happens in one full python:3.12 image: pip and its build
# machinery, the wheel cache, and the compiled artefacts all stay in the
# final layers because there is no second stage to copy out of.

FROM python:3.12

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY app.py model.joblib ./

EXPOSE 8080
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080"]
